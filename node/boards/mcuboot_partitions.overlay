/*
 * MCUboot-ready flash layout, shared by both the app image and the mcuboot
 * image itself (wired in via node/sysbuild/CMakeLists.txt) - both need the
 * same boot_partition/slot0_partition/slot1_partition nodelabels to agree
 * on where things physically live.
 *
 * Replaces the board's default single-image layout (sized for the factory
 * Adafruit UF2 bootloader - see nrf52840_partition_uf2_sdv7.dtsi in the
 * Zephyr tree) with the standard MCUboot layout used elsewhere in the
 * Zephyr tree for a bare nRF52840 (dts/vendor/nordic/nrf52840_partition.dtsi,
 * same numbers): mcuboot + two equal app slots for swap-with-revert OTA +
 * storage. This node is only ever flashed via SWD now, so there's no
 * remaining reason to preserve compatibility with the factory bootloader's
 * layout or its UF2 partition.
 *
 * Sizing: two 0x76000 (472KB) slots vs. the current single-image firmware's
 * actual flash usage of ~247KB (see PROGRESS.md /
 * arm-zephyr-eabi-size on a real build) - just under 2x headroom per slot
 * for growth.
 */
/ {
	chosen {
		/* Board default points this at the old single "code_partition",
		 * which /delete-node/ below removes along with the rest of the
		 * old layout - the app now boots from slot0, not directly from
		 * a fixed spot past a SoftDevice-shaped gap.
		 */
		zephyr,code-partition = &slot0_partition;
	};
};

&flash0 {
	/delete-node/ partitions;

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 0x0000C000>;
			read-only;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000C000 0x00076000>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 0x00076000>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000F8000 0x00008000>;
		};
	};
};
