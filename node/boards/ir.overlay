/ {
	pwmleds {
		compatible = "pwm-leds";
		ir_led: ir_led {
			pwms = <&pwm0 0 PWM_HZ(38000) PWM_POLARITY_NORMAL>;
		};
	};

	aliases {
		ir-led = &ir_led;
	};
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default_custom>;
	/delete-property/ pinctrl-1;
	pinctrl-names = "default";
};

&pinctrl {
	pwm0_default_custom: pwm0_default_custom {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
		};
	};
};
