mainmenu "Things Node"

config BLINKY
	bool "Enable blinky test mode"
	default n

config THREAD_HOSTNAME
	string "SRP hostname to register on the Thread network"
	default "thing"
	help
	  Registered via SRP once attached, so this device becomes
	  reachable as <hostname>.local from your LAN instead of needing
	  to know its Thread-assigned IPv6 address.

config THREAD_ANNOUNCE_ADDR
	string "IPv6 address to UDP-announce addresses to (debug)"
	default "fd2c:6656:1f1a:34af:4a4d:7eff:feed:5301"
	help
	  Every non-link-local IPv6 address this device gets is sent as a
	  plain UDP text message here whenever it changes - lets you
	  discover the node's reachable address without needing console
	  access. Defaults to hermes; override per build type, or set to
	  "" to disable.

config THREAD_ANNOUNCE_PORT
	int "UDP port for address announce"
	default 5555

config THING_CAPS
	string "Capability set advertised in the SRP service's TXT record"
	default ""
	help
	  Comma-separated capability tags (e.g. "ac_climate,battery"),
	  published as a single "caps" key in the _coap._udp SRP service's
	  TXT record. Lets a generic Home Assistant integration discover
	  what a given node actually supports and create the matching
	  entities - a node can declare more than one (e.g. a future board
	  mixing a PIR with a temp/humidity sensor: "pir,temp,humidity").
	  Set per build variant's conf fragment, not here - "" means no
	  capability declared.

config THREAD_STATUS_LED
	bool "RGB LED indicates Thread attach status"
	default y
	help
	  Blinks the onboard RGB LED red every 2s while attaching to
	  Thread (gives up after 60s to save battery), then solid blue
	  for 3s once attached. On by default for every build that has
	  Thread enabled (i.e. everything except CONFIG_BLINKY); disable
	  per build type in its conf fragment if not wanted.

config BLINKY_THREAD
	bool "Enable blinky+Thread test profile"
	default n
	help
	  Debug RGB LED control over Thread CoAP (POST /led) — on/off/
	  color. Unlike CONFIG_BLINKY, this runs alongside Thread rather
	  than blocking forever.

menu "IR Dialect"

config IR_VOLTAS
	bool "Voltas AC"
	default n
	help
	  Enable Voltas AC IR dialect.

config IR_TECO
	bool "Teco AC"
	default n
	help
	  Enable Teco AC IR dialect.

endmenu

source "Kconfig.zephyr"
